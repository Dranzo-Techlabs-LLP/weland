{
  "name": "weland",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "npm --prefix website run dev",
    "build": "tsc -b && vite build",
    "build:site": "npm --prefix website run build",
    "build:all": "node scripts/build-all.mjs",
    "package": "node scripts/package.mjs",
    "release": "npm run build:all && npm run package",
    "preview": "vite preview",
    "preview:all": "php -S localhost:8080 -t dist scripts/serve-dist.php",
    "lint": "tsc --noEmit",
    "lint:site": "npm --prefix website run lint"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
