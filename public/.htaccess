# Weland admin SPA — lives at /admin (public_html/admin/.htaccess on cPanel)
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /admin/

  # Serve real files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else under /admin falls through to the SPA (client-side routing)
  RewriteRule ^ index.html [L]
</IfModule>

# Content-hashed assets can be cached hard; keep HTML always fresh
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
