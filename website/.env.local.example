# Where the enquiry form posts. In production the site and the PHP API share
# a domain, so the default "/api" is right and this file is not needed.
# For `npm run dev`, point it at a running API, e.g. the local preview server
# (http://localhost:8080/api) or the live one (https://welandresort.com/api).
NEXT_PUBLIC_API_BASE=

# Public address of the site, used for share-preview (Open Graph) image URLs.
# Defaults to https://welandresort.com; set it at build time if the domain changes.
NEXT_PUBLIC_SITE_URL=
