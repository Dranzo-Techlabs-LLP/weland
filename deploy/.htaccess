# We Land Resort — public_html/.htaccess for welandresort.com (cPanel / Apache)
#
#   /         the website  (static export of website/)
#   /admin/   the admin app (has its own admin/.htaccess)
#   /api/     the PHP API   (has its own api/.htaccess)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# PHP writes "error_log" files next to its scripts (e.g. api/error_log). They can
# hold guest details and server paths, so never serve them, here or below.
<FilesMatch "^(error_log|\.user\.ini|php\.ini)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One address for the site: www.welandresort.com -> welandresort.com
  # Keeps the scheme; leaves SSL certificate checks under /.well-known alone;
  # REDIRECT_STATUS is empty only for the visitor's own request, so Apache's
  # internal hop to the 404 page is never turned into a redirect.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} =on
  RewriteCond %{HTTP_HOST} ^www\.welandresort\.com$ [NC]
  RewriteRule ^ https://welandresort.com%{REQUEST_URI} [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\.welandresort\.com$ [NC]
  RewriteRule ^ http://welandresort.com%{REQUEST_URI} [R=301,L]

  # The admin and the API route their own requests.
  RewriteRule ^(admin|api)(/|$) - [L]

  # The admin used to live at the root: send old bookmarks to /admin.
  # 302 rather than 301 so browsers don't cache it — if the website ever
  # needs one of these paths, delete that name from the list.
  RewriteRule ^(login|calendar|bookings|accounting|expenses|reports|rooms|users|roles|invoice)(/.*)?$ /admin/$1$2 [R=302,L]

  # Serve real files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Exported pages are written as name.html; serve them at /name
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Build assets (website /_next/static, admin /admin/assets) are content-hashed,
# so they can be cached for a year. Photos are not hashed: a week. HTML: never.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/x-icon "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json image/svg+xml
</IfModule>
